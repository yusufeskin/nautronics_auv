<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_actuation</name>
  <version>0.0.0</version>
  <description>
    Layer 4 of the autonomy stack: the outer control loop, and the conversion
    of its commanded wrench into the pilot-input axes ArduSub expects. It does
    not speak MAVLink - auv_hardware/pixhawk_bridge2 owns that link and
    forwards the demand this package publishes.
  </description>
  <maintainer email="yusuf.eskin@metu.edu.tr">sye</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>auv_core</depend>
  <depend>auv_core_msgs</depend>
  <depend>python3-numpy</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
