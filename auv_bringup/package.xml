<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_bringup</name>
  <version>0.0.0</version>
  <description>AUV system bringup and configuration package</description>
  <maintainer email="yusuf.eskin@metu.edu.tr">sye</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- everything the launch files start -->
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>auv_control</exec_depend>
  <exec_depend>auv_description</exec_depend>
  <exec_depend>auv_hardware</exec_depend>
  <exec_depend>auv_vision</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>gscam2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
