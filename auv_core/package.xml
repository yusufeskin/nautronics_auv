<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_core</name>
  <version>0.0.0</version>
  <description>
    Layer 0 of the autonomy stack: frame conventions, vehicle geometry, and
    the sensor gate base class. No sensor drivers and no actuator commands
    live here - only the definitions the other layers share.
  </description>
  <maintainer email="yusuf.eskin@metu.edu.tr">sye</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>auv_core_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
