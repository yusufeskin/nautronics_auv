<?xml version="1.0"?>
<model>
  <name>pool</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    25m x 50m x 2.13m textured competition pool (floor + four walls), sized to
    match the TEKNOFEST pool course. Floor is tiled in 5x5m textured squares
    so the bottom camera sees real tile detail instead of one texture
    stretched across the whole floor.
  </description>
</model>
