<?xml version="1.0"?>
<!--
  Textured competition pool: 25m x 50m x 2.13m, matching the geometry that
  used to be hand-placed in teknofest_pool.world (pool_floor + four walls).
  Include at pose "2 -3 0 0 0 0" to reproduce the original layout exactly.

  Floor/wall PBR textures (pool_floor.png, pool_tile.png, + normal/roughness
  maps) ported from HonuRobotics/bluerobotics_models
  (bluerobotics_common/models/pool), Apache-2.0. See NOTICE in this model dir.
-->
<sdf version="1.6">
  <model name="pool">
    <static>true</static>

    <!-- Floor: one physics collision box, a tiled grid of visual-only
         squares on top so the PBR texture keeps a 1:1 aspect ratio instead
         of stretching across the full 25x50m span. -->
    <link name="floor_link">
      <collision name="floor_collision">
        <pose>0 0 -2.18 0 0 0</pose>
        <geometry>
          <box><size>25.0 50.0 0.1</size></box>
        </geometry>
        <surface>
          <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
          <contact><ode/></contact>
          <bounce/>
        </surface>
      </collision>
      <visual name="floor_tile_1_visual">
        <pose>-10 -22.5 -2.13 0 0 0</pose>
        <geometry>
          <box><size>5 5 0.001</size></box>
        </geometry>
          <material>
            <ambient>0.55 0.7 0.75 1</ambient>
            <diffuse>0.7 0.82 0.85 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://pool/materials/textures/pool_floor.png</albedo_map>
                <normal_map>model://pool/materials/textures/pool_floor_normal.png</normal_map>
                <roughness_map>model://pool/materials/textures/pool_floor_roughness.png</roughness_map>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
      </visual>
