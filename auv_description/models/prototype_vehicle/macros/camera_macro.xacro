<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="add_camera" params="name parent_link topic x y z r p yaw color">

    <link name="${name}_link">
      <visual>
        <geometry>
          <box size="0.03 0.03 0.03"/>
        </geometry>
        <material name="${name}_mat">
            <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      
      <collision>
        <geometry>
          <box size="0.01 0.01 0.01"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.00000001"/>
        <inertia ixx="0.00000001" ixy="0" ixz="0" iyy="0.00000001" iyz="0" izz="0.00000001"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="${r} ${p} ${yaw}"/>
    </joint>
    <gazebo reference="${name}_link">
      <material>Gazebo/${color}</material> <!-- Simülasyondaki Renk -->
      
      <sensor name="${name}" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <!-- gz_frame_id, not frame_id: see the note in ping1d_macro.xacro. -->
        <gz_frame_id>${name}_link</gz_frame_id>
        <camera>
          <!-- Publish intrinsics next to the image (<topic>/camera_info).
               Without this gz still derives a camera_info topic, but from the
               fully-scoped sensor path, which is not what the vision nodes
               subscribe to - bbox_pnp_solver sat waiting on a topic that
               never existed. Keep this in sync with bridge.yaml. -->
          <camera_info_topic>${topic}/camera_info</camera_info_topic>
          <horizontal_fov>1.047</horizontal_fov> <!-- 60 Derece -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <!-- Mild sensor noise and lens distortion so images aren't
               pinhole-perfect; roughly a cheap wide-angle underwater lens. -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <distortion>
            <k1>-0.06</k1>
            <k2>0.01</k2>
            <k3>0.0</k3>
            <p1>0.0004</p1>
            <p2>-0.0002</p2>
            <center>0.5 0.5</center>
          </distortion>
        </camera>

        <always_on>true</always_on>

        <!-- 30 Hz, matching the real cameras. Was 100: three 640x480 render
             passes at 100 Hz is far more than the GPU delivers, so the sim
             just loses real-time factor while the images still arrive late
             and irregularly. Nothing downstream consumes faster than 30. -->
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>${topic}</topic>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>