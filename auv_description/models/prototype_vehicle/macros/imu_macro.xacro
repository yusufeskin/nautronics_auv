<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="add_imu" params="name parent_link update_rate topic:='' frame_link:='' x y z r p yaw">

    <!-- Istege bagli: sensor pozunu bir URDF link'i olarak da yayinla.
         Joint origin ve sensor <pose> AYNI parametrelerden geldigi icin
         TF ile Gazebo'daki sensor pozu her zaman senkron kalir.
         imu_sensor (ArduPilot) icin KULLANMAYIN - frame_link bos birakilir. -->
    <xacro:if value="${frame_link != ''}">
      <link name="${frame_link}"/>
      <joint name="${frame_link}_joint" type="fixed">
        <parent link="${parent_link}"/>
        <child link="${frame_link}"/>
        <origin xyz="${x} ${y} ${z}" rpy="${r} ${p} ${yaw}"/>
      </joint>
    </xacro:if>

    <gazebo reference="${parent_link}">
      <sensor name="${name}" type="imu">
        <pose>${x} ${y} ${z} ${r} ${p} ${yaw}</pose>

        <xacro:if value="${frame_link != ''}">
          <!-- gz_frame_id, frame_id degil: Harmonic (gz-sensors 8) sadece bunu okur. -->
          <gz_frame_id>${frame_link}</gz_frame_id>
        </xacro:if>

        <always_on>1</always_on>
        <update_rate>${update_rate}</update_rate>

	<imu>
	  <angular_velocity>
	    <x>
	      <noise type="gaussian">
		<mean>0.0</mean>
		<stddev>0.0087178</stddev>
	      </noise>
	    </x>
	    <y>
	      <noise type="gaussian">
		<mean>0.0</mean>
		<stddev>0.0087178</stddev>
	      </noise>
	    </y>
	    <z>
	      <noise type="gaussian">
		<mean>0.0</mean>
		<stddev>0.0087178</stddev>
	      </noise>
	    </z>
	  </angular_velocity>

	  <linear_acceleration>
	    <x>
	      <noise type="gaussian">
		<mean>0.0</mean>
		<stddev>0.1</stddev>
	      </noise>
	    </x>
	    <y>
	      <noise type="gaussian">
		<mean>0.0</mean>
		<stddev>0.1</stddev>
	      </noise>
	    </y>
	    <z>
	      <noise type="gaussian">
		<mean>0.0</mean>
		<stddev>0.1</stddev>
	      </noise>
	    </z>
	  </linear_acceleration>
	</imu>

        <xacro:if value="${topic != ''}">
          <topic>${topic}</topic>
        </xacro:if>

      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
