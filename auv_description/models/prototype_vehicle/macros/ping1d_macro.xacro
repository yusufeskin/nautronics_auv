<?xml version="1.0"?>
<!-- Blue Robotics Ping1D (Ping Sonar Altimeter/Echosounder) macro.

gz-sim has no dedicated single-beam sonar sensor, so this imitates the
Ping1D with a narrow gpu_lidar: a ~30 deg apical cone (matching the Ping1D
datasheet beam width) sampled at 32x32 rays instead of the single physical
transducer's one range reading. A consumer that wants the real Ping1D
behaviour (one Range message) should reduce this scan to its minimum valid
return, not consume every ray as if it were a multi-beam sonar. -->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="add_ping1d" params="name parent_link topic x y z r p yaw">

    <link name="${name}_link">
      <inertial>
        <mass value="0.00000001"/> <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00000001" ixy="0" ixz="0" iyy="0.00000001" iyz="0" izz="0.00000001"/>
      </inertial>
      
      <visual>
        <origin xyz="0 0 0" rpy="0 1.5707 0"/>
        <geometry>
          <cylinder length="0.022" radius="0.018"/>
        </geometry>
        <material name="ping_blue">
          <color rgba="0.1 0.1 0.8 1"/> </material>
      </visual>
      
      <collision>
        <origin xyz="0 0 0" rpy="0 1.5707 0"/>
        <geometry>
          <cylinder length="0.022" radius="0.018"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="${r} ${p} ${yaw}"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor name="${name}_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        
        <topic>${topic}</topic>
        
        <!-- Real Ping1D pings at roughly 10 Hz; it is time-of-flight bound,
             it cannot do 30. Also one fewer GPU render pass per frame. -->
        <update_rate>10</update_rate>
        
        <always_on>true</always_on>
        <visualize>true</visualize>
        
        <!-- gz_frame_id, NOT frame_id: gz-sensors 8 (Harmonic, what this repo
             targets) only reads gz_frame_id. frame_id arrives in gz-sensors 9
             (Ionic), which then deprecates this one - swap on that upgrade. -->
        <gz_frame_id>${name}_link</gz_frame_id>
        
        <lidar>
          <scan>
            <horizontal>
              <samples>32</samples> <resolution>1</resolution>
              <min_angle>-0.26</min_angle> <max_angle>0.26</max_angle>  </horizontal>

            <vertical>
              <samples>32</samples> <resolution>1</resolution>
              <min_angle>-0.26</min_angle> <max_angle>0.26</max_angle>  </vertical>
          </scan>
          
          <range>
            <min>0.5</min>
            <max>50.0</max> <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev> </noise>
        </lidar>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>