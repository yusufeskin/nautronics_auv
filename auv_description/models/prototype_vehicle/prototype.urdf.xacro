<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="prototype">

  <xacro:include filename="macros/pipe_macro.xacro" />
  <xacro:include filename="macros/thruster_macro.xacro" />
  <xacro:include filename="macros/plugins.xacro" />
  <xacro:include filename="macros/imu_macro.xacro"/>
  <xacro:include filename="macros/ping1d_macro.xacro" />
  <xacro:include filename="macros/camera_macro.xacro" />
  <xacro:include filename="macros/dvl_macro.xacro" />

  <link name="base_link">
    
    <inertial>
      <origin xyz="0 0 -0.0114" rpy="0 0 0"/> 
      <mass value="12.8"/> <inertia 
        ixx="0.26" ixy="0" ixz="0" 
        iyy="0.23" iyz="0" 
        izz="0.37"/>    
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auv_description/models/prototype_vehicle/meshes/sim.obj"/>
      </geometry>
    </visual>

    <!-- This box is what the world's Buoyancy plugin displaces, so its VOLUME
         sets net buoyancy (0.457*0.575*0.05 * 1000 = 13.14 kg vs 12.8 kg mass,
         i.e. slightly positive) and its CENTROID is the centre of buoyancy.
         z=0.0376 puts the CoB 0.049 m above the CoM at z=-0.0114 - the same
         separation bluerov2_heavy/model.sdf uses (0.060 vs 0.011).
         Was 0.376 (a dropped zero): that sat 20 cm above the hull's actual
         top (the mesh ends at z=0.145), giving an 8x too stiff righting
         moment and a vehicle that could never float to the surface. -->
    <collision name="base_collision">
      <origin xyz="0 0 0.0376" rpy="0 0 0"/>
      <geometry>
        <box size="0.457 0.575 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Flight IMU. ArduPilotPlugin binds to it by sensor NAME (<imuName>), not
       by topic; the explicit topic is only so bridge.yaml can expose it to ROS
       for debugging. Without it gz publishes on the fully-scoped sensor path
       and the bridge entry matches nothing. -->
  <xacro:add_imu name="imu_sensor" parent_link="base_link" update_rate="400.0"
                 topic="/model/prototype_vehicle/imu"
                 x="0" y="0" z="0" r="${pi}" p="0" yaw="0" />
                 
  <xacro:add_imu name="vio_imu" parent_link="base_link" update_rate="50.0" topic="/imu0" 
                 x="0" y="0" z="0" r="0" p="0" yaw="0" />
  <xacro:add_ping1d
      name="ping1d_sonar"
      parent_link="base_link"
      topic="/sensors/sonar/front"
      x="0.188254" y="-0.038661" z="0.09952"
      r="0.0" p="0.0" yaw="0.0" />

  <xacro:add_camera
    name="front_camera"
    parent_link="base_link"
    topic="/camera/front"
    x="0.177035" y="0.0" z="0.0"
    r="0.0" p="0.0" yaw="0.0"
    color="Blue" />

    <xacro:add_camera
    name="bottom_camera"
    parent_link="base_link"
    topic="/camera/bottom"
    x="0.0" y="0.0" z="-0.043071"
    r="0.0" p="1.57" yaw="0.0"
    color="Green" />

    <xacro:add_camera
    name="back_camera"
    parent_link="base_link"
    topic="/camera/back"
    x="-0.177035" y="0.0" z="0.0"
    r="0.0" p="0.0" yaw="3.14"
    color="Green" />

  <xacro:add_dvl
    name="dvl"
    parent_link="base_link"
    topic="/model/prototype_vehicle/dvl"
    update_rate="8"
    x="0.0" y="0.0" z="-0.15"
    r="0.0" p="0.0" yaw="0.0" />

  <xacro:add_thruster id="1" x="0.2201"  y="-0.1126" z="-0.0224" r="-1.571" p="1.571" yaw="-0.785" prop_type="ccw" coeff="0.02" />
  <xacro:add_thruster id="2" x="0.2201"  y="0.1126"  z="-0.0224" r="-1.571" p="1.571" yaw="-2.356" prop_type="ccw" coeff="0.02" />
  <xacro:add_thruster id="3" x="-0.2201" y="-0.1126" z="-0.0224" r="-1.571" p="1.571" yaw="0.785"  prop_type="cw"  coeff="-0.02" />
  <xacro:add_thruster id="4" x="-0.2201" y="0.1126"  z="-0.0224" r="-1.571" p="1.571" yaw="2.356"  prop_type="cw"  coeff="-0.02" />
  
  <xacro:add_thruster id="5" x="0.0884"  y="-0.2126" z="0.0056"  r="0" p="0" yaw="0" prop_type="ccw" coeff="0.02" />
  <xacro:add_thruster id="6" x="0.0884"  y="0.2126"  z="0.0056"  r="0" p="0" yaw="0" prop_type="cw"  coeff="-0.02" />
  <xacro:add_thruster id="7" x="-0.0884" y="-0.2126" z="0.0056"  r="0" p="0" yaw="0" prop_type="cw"  coeff="-0.02" />
  <xacro:add_thruster id="8" x="-0.0884" y="0.2126"  z="0.0056"  r="0" p="0" yaw="0" prop_type="ccw" coeff="0.02" />

<gazebo reference="base_link">
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>base_link</parent_link>
      
      <child_model>torpedo_model1</child_model>
      <child_link>torpedo_body</child_link>
      
      <detach_topic>/torpedo/fire1</detach_topic>
    </plugin>
  </gazebo>

    <gazebo>
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>base_link</parent_link>
      
      <child_model>torpedo_model2</child_model>
      <child_link>torpedo_body</child_link>
      
      <detach_topic>/torpedo/fire2</detach_topic>
    </plugin>
  </gazebo>


</robot>