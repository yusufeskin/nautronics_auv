<sdf version="1.6">
  <world name="prototype_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <sky><clouds><speed>12</speed></clouds></sky>
      <shadows>false</shadows>
    </scene>

    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri></include>



    <model name='pool_floor'>
      <static>1</static>
      <pose>2 -3 0 0 0 0</pose>
      <link name='pool_floor_link'>
        <collision name='pool_floor_collision'>
          <geometry>
            <box>
              <size>300 300 0.1</size>
            </box>
          </geometry>
          <pose>0 0 -2.18 0 0 0</pose>
          <max_contacts>10</max_contacts>
          <surface>
            <friction>
              <ode>
                <mu>0.5</mu>
                <mu2>0.5</mu2>
              </ode>
            </friction>
            <contact>
              <ode/>
            </contact>
            <bounce/>
          </surface>
        </collision>
        <visual name='pool_floor_visual'>
          <geometry>
            <box>
              <size>300 300 0.1</size>
            </box>
          </geometry>
          <pose>0 0 -2.18 0 0 0</pose>
          <material>
            <ambient>0.5 0.83 0.85 1</ambient>
            <diffuse>0.5 0.83 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>
 

    <include>
      <uri>model://teknofest_pipe</uri>
      <name>pipe</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!--
      Waypoint markers (visual only, no collision) - purely for eyeballing
      whether the vehicle actually reaches multi_point_transit.py's WAYPOINTS.
      Positions are WAYPOINTS' local NED (x=North,y=East,z=Down) converted to
      this Gazebo world's ENU frame via the spawn_entity pose in
      gazebo.launch.py (-9, 5, -1.0) and ArduPilotPlugin's gazeboXYZToNED
      (standard ENU<->NED swap, verified empirically): gazebo_x = spawn_x + E,
      gazebo_y = spawn_y + N, gazebo_z = spawn_z - D. Valid only for a genuinely
      fresh Gazebo+SITL restart (DVL lock acquired right at spawn, no manual
      flight beforehand) - re-derive if WAYPOINTS or the spawn pose change.
    -->
    <model name='waypoint_marker_1'>
      <static>1</static>
      <pose>-15.65 13.97 -1.70 0 0 0</pose>
      <link name='waypoint_marker_1_link'>
        <visual name='waypoint_marker_1_visual'>
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material>
            <ambient>1 0 0 0.8</ambient>
            <diffuse>1 0 0 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='waypoint_marker_2'>
      <static>1</static>
      <pose>-22.77 7.78 -1.70 0 0 0</pose>
      <link name='waypoint_marker_2_link'>
        <visual name='waypoint_marker_2_visual'>
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material>
            <ambient>0 1 0 0.8</ambient>
            <diffuse>0 1 0 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='waypoint_marker_3'>
      <static>1</static>
      <pose>-16.83 -0.57 -1.70 0 0 0</pose>
      <link name='waypoint_marker_3_link'>
        <visual name='waypoint_marker_3_visual'>
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material>
            <ambient>0 0 1 0.8</ambient>
            <diffuse>0 0 1 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>



    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-dvl-system" name="gz::sim::systems::DopplerVelocityLogSystem"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>


    <plugin
        filename="gz-sim-buoyancy-system"
        name="gz::sim::systems::Buoyancy">
      <!-- Fluid density is 1 (air) above 0 and 1000 (water) below 0 -->
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <!-- Enable by model name -->
      <enable>prototype_vehicle</enable>
    </plugin>

  </world>
</sdf>
