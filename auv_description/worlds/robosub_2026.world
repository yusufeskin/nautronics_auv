<?xml version="1.0" ?>
<!--
  RoboSub 2026 competition course.

  Task models and course layout are the ITU AUV Team's, from
  https://github.com/itu-auv/auv-software (BSD 3-Clause, Copyright (c) 2024
  ITU AUV Team) - see models/ITU_AUV_NOTICE.  The layout is their
  semi_final_pool.world "course 2" set, whose pool_floor is included at the
  same pose as our models/pool (2 -3 0), so their poses carry over unchanged.
  The octagon and the two path markers are not in that set; they are placed
  here to continue the same run, using the octagon/animals offset from their
  start_pool_world.launch (animals 1.35 m towards -X and 1.35 m higher).

  Heights differ from upstream by the amount needed to sit right in this pool,
  measured off the meshes (both have their origin at their lowest point):
    gate     z -1.50 -> -1.67   mesh is 1.565 m tall, so the top bar now hangs
                                0.10 m UNDER the surface instead of 0.07 m over
    octagon  z -1.95 -> -2.13   mesh is 2.013 m tall: table feet now rest on the
                                floor and the ring floats just under the surface
    animals  z -0.60 -> -0.78   keeps upstream's +1.35 m offset from the octagon
    paths    z -2.1336 -> -2.13 feet exactly on the floor, not 4 mm into it

  Run order, along +X from the vehicle spawn in launch/gazebo.launch.py:

      Task 1  Begin Assessment (gate)        -5.00,  3.25
      path marker, gate -> slalom            -3.00,  2.60
      Task 2  Avoid Debris (slalom), 3 sets  -0.75 .. 2.25
      path marker, slalom -> bins             3.40,  3.60
      Task 3  Recon (bins)                    4.70,  6.00
      Task 4  Deploy (torpedoes)              8.40,  8.00
      Task 5  Restore (octagon)              11.50,  9.50
      Task 6  Return Home is the gate again.

  No acoustic pingers are modelled.  Pool is models/pool: 25 x 50 m, floor at
  z = -2.13, surface z = 0.
-->
<sdf version="1.6">
  <world name="robosub_2026">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.35 0.45 0.5 1.0</ambient>
      <background>0.3 0.5 0.6 1.0</background>
      <sky><clouds><speed>12</speed></clouds></sky>
      <shadows>true</shadows>
      <fog>
        <color>0.05 0.25 0.35 1.0</color>
        <type>linear</type>
        <density>0.01</density>
        <start>8</start>
        <end>45</end>
      </fog>
    </scene>

    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri></include>

    <include>
      <uri>model://pool</uri>
      <name>pool</name>
      <pose>2 -3 0 0 0 0</pose>
    </include>

    <!-- Task 1 / Task 6 -->
    <include>
      <uri>model://robosub_gate</uri>
      <name>robosub_gate</name>
      <pose>-5 3.25 -1.67 0 0 0.2</pose>
    </include>

    <include>
      <uri>model://robosub_path</uri>
      <name>path_gate_to_slalom</name>
      <pose>-3.0 2.6 -2.13 0 0 -0.340</pose>
    </include>

    <!-- Task 2: three pipe sets -->
    <include>
      <uri>model://robosub_slalom</uri>
      <name>robosub_slalom_1</name>
      <pose>-0.75 1.75 -1.35 0 0 1.57</pose>
    </include>
    <include>
      <uri>model://robosub_slalom</uri>
      <name>robosub_slalom_2</name>
      <pose>0.75 2.5 -1.35 0 0 1.57</pose>
    </include>
    <include>
      <uri>model://robosub_slalom</uri>
      <name>robosub_slalom_3</name>
      <pose>2.25 1.75 -1.35 0 0 1.57</pose>
    </include>

    <include>
      <uri>model://robosub_path</uri>
      <name>path_slalom_to_bins</name>
      <pose>3.4 3.6 -2.13 0 0 1.048</pose>
    </include>

    <!-- Task 3 -->
    <include>
      <uri>model://robosub_bin</uri>
      <name>robosub_bin</name>
      <pose>4.7 6 -1.6 0 0 -0.25</pose>
    </include>

    <!-- Task 4.  The mesh is authored lying down, hence the roll of pi/2. -->
    <include>
      <uri>model://robosub_torpedo</uri>
      <name>robosub_torpedo</name>
      <pose>8.4 8 -2 1.57 0 -2.9</pose>
    </include>

    <!-- Task 5: octagon, with the four role images hanging inside it. -->
    <include>
      <uri>model://robosub_octagon</uri>
      <name>robosub_octagon</name>
      <pose>11.5 9.5 -2.13 0 0 0</pose>
    </include>
    <include>
      <uri>model://robosub_octagon_animals</uri>
      <name>robosub_octagon_animals</name>
      <pose>10.15 9.5 -0.78 0 0 0</pose>
    </include>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-dvl-system" name="gz::sim::systems::DopplerVelocityLogSystem"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
        filename="gz-sim-buoyancy-system"
        name="gz::sim::systems::Buoyancy">
      <!-- Fluid density is 1 (air) above 0 and 1000 (water) below 0 -->
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <!-- Enable by model name -->
      <enable>prototype_vehicle</enable>
    </plugin>

  </world>
</sdf>
