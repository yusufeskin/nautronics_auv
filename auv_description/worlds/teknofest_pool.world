<sdf version="1.6">
  <world name="prototype_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.35 0.45 0.5 1.0</ambient>
      <background>0.3 0.5 0.6 1.0</background>
      <sky><clouds><speed>12</speed></clouds></sky>
      <shadows>true</shadows>
      <!-- Faint blue-green underwater haze; starts past most of the pool's
           width so the course stays fully visible, just tints the far wall. -->
      <fog>
        <color>0.05 0.25 0.35 1.0</color>
        <type>linear</type>
        <density>0.01</density>
        <start>8</start>
        <end>45</end>
      </fog>
    </scene>

    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri></include>



    <!-- Textured 25x50m pool (floor + 4 walls), models/pool/. Same pose as
         the old inline pool_floor model so nothing else in this world
         (spawn pose, waypoint markers, lane markers) needs to move. -->
    <include>
      <uri>model://pool</uri>
      <name>pool</name>
      <pose>2 -3 0 0 0 0</pose>
    </include>
    <model name='lane_marker_1'>
      <static>1</static>
      <pose>2 7 -2.134 0 0 0</pose>
      <link name='lane_marker_1_link'>
        <visual name='lane_marker_1_visual'>
          <geometry>
            <box>
              <size>24.4 0.2 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>
    <model name='lane_marker_2'>
      <static>1</static>
      <pose>2 4.5 -2.134 0 0 0</pose>
