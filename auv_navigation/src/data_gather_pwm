import rclpy
from rclpy.node import Node
from pymavlink import mavutil
import csv
import os

class DirectPwmCsvWriter(Node):
    def __init__(self):
        super().__init__('direct_pwm_csv_writer')
        
        # 1. CSV Dosyası Hazırlığı
        self.csv_file_path = 'pwm_recordings.csv'
        file_exists = os.path.isfile(self.csv_file_path)
        
        # Dosyayı 'a' (append) modunda açıyoruz
        self.file = open(self.csv_file_path, mode='a', newline='')
        self.csv_writer = csv.writer(self.file)
        
        # Dosya yeniyse başlıkları yaz
        if not file_exists:
            self.csv_writer.writerow([
                'timestamp', 'servo1', 'servo2', 'servo3', 
                'servo4', 'servo5', 'servo6', 'servo7', 'servo8'
            ])
            
        self.get_logger().info(f'Veriler {self.csv_file_path} dosyasına ekleniyor...')

        # 2. MAVLink Bağlantısı
        self.connect_mavlink()

        # 3. Veri Okuma Döngüsü (Timer) - Topic dinlemek yerine her 0.02 saniyede (50Hz) MAVLink'i kontrol eder
        self.timer = self.create_timer(0.02, self.timer_callback)

    def connect_mavlink(self):
        self.connection = mavutil.mavlink_connection('tcp:127.0.0.1:5762')
        self.connection.wait_heartbeat()
        self.get_logger().info('MAVLink bağlantısı başarılı.')
        
        frequency_hz = 50
        self.connection.mav.command_long_send(
            self.connection.target_system,
            self.connection.target_component,
            mavutil.mavlink.MAV_CMD_SET_MESSAGE_INTERVAL,
            0,
            36, # SERVO_OUTPUT_RAW mesaj ID'si
            1e6 / frequency_hz,
            0, 0, 0, 0, 0
        )

    def timer_callback(self):
        # MAVLink üzerinden SERVO_OUTPUT_RAW mesajını çek
        msg = self.connection.recv_match(type='SERVO_OUTPUT_RAW', blocking=False)
        
        if msg:
            # ROS zamanını al
            timestamp = self.get_clock().now().nanoseconds / 1e9
            
            # CSV'ye yazılacak satırı oluştur
            row = [
                timestamp,
                float(msg.servo1_raw),
                float(msg.servo2_raw),
                float(msg.servo3_raw),
                float(msg.servo4_raw),
                float(msg.servo5_raw),
                float(msg.servo6_raw),
                float(msg.servo7_raw),
                float(msg.servo8_raw)
            ]
            
            # Satırı yaz ve diske kaydet
            self.csv_writer.writerow(row)
            self.file.flush()

    def destroy_node(self):
        # Kapanırken dosyayı güvenli bir şekilde kapat
        if hasattr(self, 'file') and not self.file.closed:
            self.file.close()
            self.get_logger().info('CSV dosyası güvenli bir şekilde kapatıldı.')
        super().destroy_node()

def main(args=None):
    rclpy.init(args=args)
    node = DirectPwmCsvWriter()
    
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()